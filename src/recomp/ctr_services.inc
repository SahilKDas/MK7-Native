std::unordered_map<std::uint32_t,std::pair<std::uint32_t,std::uint32_t>> shared_objects;
struct CtrServiceState {std::uint32_t hid_shared{},hid_events[5]{},gsp_shared{},gsp_event{},apt_lock{},apt_events[2]{};bool gsp_right{},apt_initialized{},apt_enabled{};std::uint32_t apt_cpu_limit=30;std::uint64_t next_archive=1;};
CtrServiceState services;
std::unordered_map<std::uint64_t,std::uint32_t> archives;
void ipc_handles(std::uint32_t a,std::uint16_t c,std::initializer_list<std::uint32_t> v,std::uint32_t r=0){write(a,(std::uint32_t(c)<<16)|0x40u|std::uint32_t(v.size()+1));write(a+4,r);write(a+8,0u);std::uint32_t o=12;for(auto x:v){write(a+o,x);o+=4;}}
std::uint32_t shared_handle(std::uint32_t& s,const char* n,std::uint32_t a,std::uint32_t z){if(!s){if(std::uint64_t(a)+z>mem.size()){unwind=true;return 0;}std::fill(mem.begin()+a,mem.begin()+a+z,std::byte{});s=make_handle(n);shared_objects.emplace(s,std::pair{a,z});}return s;}
std::uint32_t event_handle(std::uint32_t& s,const char* n){if(!s)s=make_handle(n);return s;}
void update_hid_memory(){if(!services.hid_shared)return;const auto o=shared_objects.find(services.hid_shared);if(o==shared_objects.end())return;const auto b=o->second.first;static std::uint32_t tick=0;write(b,tick++);write(b+4,input_buttons);write(b+8,std::int16_t(std::clamp(circle_x,-1.0f,1.0f)*156.0f));write(b+10,std::int16_t(std::clamp(circle_y,-1.0f,1.0f)*156.0f));}
void dispatch_hid(std::uint32_t b,std::uint16_t c){if(c==0x000a){const auto s=shared_handle(services.hid_shared,"hid shared memory",mem.size()>0x0ff01000u?0x0ff00000u:0x800u,0x1000u);for(unsigned i=0;i<5;++i)event_handle(services.hid_events[i],"hid event");update_hid_memory();ipc_handles(b,c,{s,services.hid_events[0],services.hid_events[1],services.hid_events[2],services.hid_events[3],services.hid_events[4]});return;}if(c>=0x0011&&c<=0x0014){ipc_result(b,c,0);return;}if(c==0x0015){write(b,(std::uint32_t(c)<<16)|0x80u);write(b+4,0u);write(b+8,std::bit_cast<std::uint32_t>(14.375f));return;}if(c==0x0016){write(b,(std::uint32_t(c)<<16)|0x100u);for(unsigned i=1;i<5;++i)write(b+i*4,0u);return;}if(c==0x0017){write(b,(std::uint32_t(c)<<16)|0x80u);write(b+4,0u);write(b+8,63u);return;}ipc_result(b,c,0xd900182fu);}
void process_gsp_queue(){if(!services.gsp_shared)return;const auto o=shared_objects.find(services.gsp_shared);if(o==shared_objects.end())return;const auto q=o->second.first+0x800u;auto header=read<std::uint32_t>(q);auto index=header&0xffu,count=(header>>8)&0xffu;while(count&&index<15){const auto command=q+0x20u+index*0x20u,id=read<std::uint32_t>(command)&0xffu;if(id==0){const auto src=read<std::uint32_t>(command+4),dst=read<std::uint32_t>(command+8),size=read<std::uint32_t>(command+12);if(std::uint64_t(src)+size<=mem.size()&&std::uint64_t(dst)+size<=mem.size())std::memmove(mem.data()+dst,mem.data()+src,size);}else if(id==1)pica200_decode_command_list(read<std::uint32_t>(command+4),read<std::uint32_t>(command+8));else if(id==2){pica200_memory_fill(read<std::uint32_t>(command+4),read<std::uint32_t>(command+12),read<std::uint32_t>(command+8),read<std::uint16_t>(command+28));pica200_memory_fill(read<std::uint32_t>(command+16),read<std::uint32_t>(command+24),read<std::uint32_t>(command+20),read<std::uint16_t>(command+30));}else if(id==3||id==4){const auto src=read<std::uint32_t>(command+4),dst=read<std::uint32_t>(command+8),size=id==4?read<std::uint32_t>(command+12):std::min(read<std::uint32_t>(command+12),read<std::uint32_t>(command+16));if(std::uint64_t(src)+size<=mem.size()&&std::uint64_t(dst)+size<=mem.size())std::memmove(mem.data()+dst,mem.data()+src,size);}index=(index+1)%15;--count;}write(q,(header&0xffff0000u)|index|(count<<8));}void dispatch_gsp(std::uint32_t b,std::uint16_t c){if(c==0x0005){const auto screen=read<std::uint32_t>(b+4),active=read<std::uint32_t>(b+8),left=read<std::uint32_t>(b+12),right=read<std::uint32_t>(b+16),stride=read<std::uint32_t>(b+20),format=read<std::uint32_t>(b+24);pica200_set_framebuffer(screen,active?right:left,stride,format);ipc_result(b,c,0);return;}if(c==0x0013){const auto s=shared_handle(services.gsp_shared,"gsp command queue",mem.size()>0x0ff02000u?0x0ff01000u:0x1800u,0x1000u);event_handle(services.gsp_event,"gsp interrupt event