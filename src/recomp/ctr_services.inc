void dispatch_fs(std::uint32_t b,std::uint16_t c){if(c==0x0801||c==0x0861||c==0x0862){ipc_result(b,c,0);return;}if(c==0x0863){write(b,(std::uint32_t(c)<<16)|0x80u);write(b+4,0u);write(b+8,0u);return;}if(c==0x080c){const auto id=services.next_archive++;archives.emplace(id,read<std::uint32_t>(b+4));write(b,(std::uint32_t(c)<<16)|0xc0u);write(b+4,0u);write(b+8,std::uint32_t(id));write(b+12,std::uint32_t(id>>32));return;}if(c==0x080e){const std::uint64_t id=std::uint64_t(read<std::uint32_t>(b+4))|(std::uint64_t(read<std::uint32_t>(b+8))<<32);if(!archives.erase(id)){ipc_result(b,c,0xd8e007f7u);return;}ipc_result(b,c,0);return;}if(c==0x0802||c==0x0803||c==0x080b){ipc_handles(b,c,{make_handle(c==0x080b?"fs directory":"fs file")});return;}ipc_result(b,c,0xd900182fu);}
void dispatch_apt(std::uint32_t b,std::uint16_t c){if(c==0x0001){event_handle(services.apt_lock,"apt lock");ipc_handles(b,c,{services.apt_lock});return;}if(c==0x0002){services.apt_initialized=true;event_handle(services.apt_events[0],"apt notification event");event_handle(services.apt_events[1],"apt parameter event");ipc_handles(b,c,{services.apt_events[0],services.apt_events[1]});return;}if(c==0x0003){services.apt_enabled=true;ipc_result(b,c,0);return;}if(c==0x0004){services.apt_enabled=false;services.apt_initialized=false;ipc_result(b,c,0);return;}if(c==0x000b){write(b,(std::uint32_t(c)<<16)|0x80u);write(b+4,0u);write(b+8,0u);return;}if(c==0x004b){ipc_result(b,c,0);return;}if(c==0x004f){services.apt_cpu_limit=read<std::uint32_t>(b+8);ipc_result(b,c,0);return;}if(c==0x0050){write(b,(std::uint32_t(c)<<16)|0x80u);write(b+4,0u);write(b+8,services.apt_cpu_limit);return;}ipc_result(b,c,0xd900182fu);}
